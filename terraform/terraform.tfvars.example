# Copie para terraform.tfvars (que é ignorado pelo git) e preencha com os valores
# reais do seu projeto. Nenhum valor aqui é real — são placeholders.

project_id             = "seu-projeto-gcp"
region                 = "us-east1"
service_account_email  = "sua-service-account@seu-projeto-gcp.iam.gserviceaccount.com"
service_audience_url   = "https://seu-servico-xxxxx.a.run.app"

# Quem pode fazer deploy pelo GitHub Actions (ADR 0015): o repositório de conteúdo.
github_deploy_repository    = "seu-usuario/seu-repo-de-conteudo"
github_deploy_repository_id = "123456789" # gh api repos/seu-usuario/seu-repo-de-conteudo --jq .id

smtp_user = "seu-email-de-envio@example.com"
smtp_from = "LogN App <seu-email-de-envio@example.com>"
smtp_host = "smtp.example.com"
smtp_port = "465" # 465 = TLS implícito; 587 = STARTTLS (o gomail escolhe pela porta)
# A senha SMTP não passa pelo Terraform: vai direto para o secret logn-smtp-pass, com
#   printf '%s' "a-senha" | gcloud secrets versions add logn-smtp-pass --data-file=-

# Imagem já publicada no Artifact Registry (ver README para como gerar).
container_image = "us-east1-docker.pkg.dev/seu-projeto-gcp/cloud-run-source-deploy/logn@sha256:..."

# Verificação de origem — deixe desligada até o domínio estar registrado.
enable_origin_verification = false
origin_trusted_cidrs       = "" # só usado com enable_cloudflare=false (outro proxy)

# Cloudflare — domínio já registrado e adicionado como zona na conta (o Terraform lê a
# zona pelo nome, não cria). Ligue junto com enable_origin_verification acima.
enable_cloudflare    = false
cloudflare_api_token = "seu-api-token-com-escopo-zone-dns-ruleset-edit"
domain_name          = "seu-dominio.sh"
api_subdomain        = "api"
