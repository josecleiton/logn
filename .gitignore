# Conteúdo da trilha — vive no repositório privado logn-conteudo.
#
# Engenharia é pública, currículo não: enunciados, gabaritos, explicações e a árvore de
# nós com os portões de XP. Aqui entra só migração de schema, e cada uma é liberada
# pelo nome de propósito. Esquecer de liberar uma nova quebra o build na hora, e isso é
# muito melhor do que vazar currículo sem ninguém notar.
backend/schema/migrations/*.sql
!backend/schema/migrations/0000_schema_inicial.sql
!backend/schema/migrations/0005_challenges_ordem_e_invariantes.sql
!backend/schema/migrations/0006_spot_the_bug_exige_correct_line.sql
!backend/schema/migrations/0010_challenges_origin.sql
!backend/schema/migrations/0013_carimbos_de_tempo.sql
!backend/schema/migrations/0031_endurece_autenticacao.sql
!backend/schema/migrations/0032_xp_paga_uma_vez.sql
!backend/schema/migrations/0033_challenges_sem_version.sql
!backend/schema/migrations/0034_created_at_obrigatorio.sql

