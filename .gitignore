ios/LogNiOS/LogNiOS/DesignSystem/Localizable.xcstrings
ios/LogNiOS/LogNiOS/DesignSystem/Strings.swift
ios/LogNiOS/LogNiOS/DesignSystem/StringsMappers.swift
ios/LogNiOS/LogNiOS/DesignSystem/InfoPlist/

# O documento que ensina a escrever desafio, e o gerador do conteúdo.
docs/testing/prompt-seed-desafios.md
tools/dump_conteudo.py

# A trilha empacotada carrega os 36 desafios inteiros para dentro do app.
# `just seed-bundle` a gera a partir do banco; quem clona o repositório público monta a
# sua com o conteúdo que tiver.
ios/LogNiOS/LogNiOS/Resources/trail-seed.json
backend/backend
backend/test_match_sync
