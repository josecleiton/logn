# Configuração base para ambiente de desenvolvimento local
# Copie este arquivo para `.env` (gitignored).

# Base URL para a API backend (usada pelos clientes mobile, scripts, etc)
API_BASE_URL=http://localhost:8080

# Chave do PostHog (Vazia em dev para não sujar os dados de produção)
TELEMETRY_KEY=phc_SuaChaveAqui
POSTHOG_HOST=https://us.i.posthog.com

# URL do banco de dados local
DATABASE_URL=postgres://logn:lognpassword@localhost:5432/logndb?sslmode=disable

# JWT Secret para assinatura de tokens no backend
JWT_SECRET=super-secret-key-mudar-em-producao
CLOUD_SCHEDULER_AUDIENCE=https://sua-api.run.app
