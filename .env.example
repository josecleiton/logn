# Configuração base para ambiente de desenvolvimento local
# Copie este arquivo para `.env` (gitignored).

# Base URL para a API backend (usada pelos clientes mobile, scripts, etc)
API_BASE_URL=http://localhost:8080

# Chave do PostHog (Vazia em dev para não sujar os dados de produção)
TELEMETRY_KEY=phc_SuaChaveAqui
POSTHOG_HOST=https://us.i.posthog.com

# Upload dos símbolos de release para o Error Tracking (ADR 0024), lido só por
# `just android/release`. A chave é pessoal (phx_), com os escopos `error tracking write`
# e `organization read`, e nunca vai para o app: o Gradle não lê estas chaves e o
# `just sync-env` as deixa fora do Local.xcconfig. O host é o do app, não o de ingestão.
POSTHOG_CLI_HOST=https://us.posthog.com
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_API_KEY=phx_SuaChaveAqui

# URL do banco de dados local
DATABASE_URL=postgres://logn:lognpassword@localhost:5432/logndb?sslmode=disable

# JWT Secret para assinatura de tokens no backend
JWT_SECRET=super-secret-key-mudar-em-producao
CLOUD_SCHEDULER_AUDIENCE=https://sua-api.run.app

# Trilha paga. Em produção os dois primeiros são obrigatórios e o servidor não sobe sem eles.
# TRACK_KEY_SECRET: 32 bytes em base64 (`openssl rand -base64 32`); cifra as chaves de conteúdo.
TRACK_KEY_SECRET=
APPLE_BUNDLE_ID=sh.logn.app
# Só em desenvolvimento, para o StoreKit Testing do Xcode: caminho do certificado raiz
# exportado do Xcode (Editor > Save Public Certificate), em DER ou PEM. Recusado no Cloud Run.
APPLE_XCODE_ROOT_CERT=

# Login com Google (ADR 0016): o Client ID iOS do Google Auth Platform, a audiência que o
# servidor exige no ID token. Vazio desliga o login com Google. O mesmo valor vai no
# GOOGLE_IOS_CLIENT_ID do ios/LogNiOS/Local.xcconfig.
GOOGLE_IOS_CLIENT_ID=

# Login com GitHub (ADR 0019): o Client ID do OAuth App, com callback logn://oauth/github,
# e o secret dele. Os dois juntos, ou nenhum. O Client ID vai também ao app, pelo
# Local.xcconfig; o secret não: o `just sync-env` deixa de fora todo `*_SECRET`. No Cloud
# Run o secret vem em SERVER_KEYS.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sign in with Apple (ADR 0017). As três juntas, ou nenhuma: sem a chave, a Apple fica
# desligada no servidor. A chave é a .p8 em PEM numa linha só, com `\n` no lugar das
# quebras: o `just sync-env` copia o .env para o Local.xcconfig, que não aceita valor em
# várias linhas. Só é preciso aqui para testar a revogação na máquina; o Info.plist não
# lê a chave, então ela não vai para o app.
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# No app: o arquivo de entitlements com a capability. Vazio enquanto o time for o
# gratuito, que não assina a capability; aí o botão da Apple também não aparece.
LOGN_CODE_SIGN_ENTITLEMENTS=
