# LogN Android — `just android/<receita>` da raiz, ou `just <receita>` daqui.
#
# O código gerado (tipos do Core, ponte boltffi, .so, strings) vive em android/generated/,
# fora do git. `generate` o refaz inteiro; o Gradle recusa o build se o Core ou o
# catálogo mudaram depois do último (`verifyGenerated`, em core-shell).

set shell := ["bash", "-euo", "pipefail", "-c"]
set working-directory := ".."

ndk := env("ANDROID_NDK_HOME", env("HOME") / "Library/Android/sdk/ndk/29.0.14206865")
app := "sh.logn.app"

default:
    @just --list --justfile android/Justfile

# Tipos do Core em Kotlin (facet typegen), pacote sh.logn.core.
typegen:
    cd shared_core && cargo run --bin codegen --features codegen -- --language kotlin --output-dir ../android/generated/typegen

# Strings do catálogo em res/values*/strings.xml e os acessores `Str`.
i18n:
    cargo run --manifest-path tools_i18n/Cargo.toml -- --language kotlin --catalog i18n --output-dir android/generated/localization --android-package sh.logn.coreshell --core-package sh.logn.core

# A ponte JNI e o .so de cada ABI. `just android/ffi release` para o build de loja.
ffi profile="debug":
    cd shared_core && ANDROID_NDK_HOME={{ ndk }} boltffi pack android {{ if profile == "release" { "--release" } else { "" } }}
    echo {{ profile }} >| android/generated/PROFILE

# Tudo que o Gradle espera em android/generated/.
generate profile="debug": typegen i18n (ffi profile)
    touch android/generated/STAMP

# Semente da trilha e documentos legais nos assets (fora do git, regra 8). Backend de pé.
seed:
    SEED_BUNDLE_OUT=android/app/src/main/assets/trail-seed.json python3 tools/seed_bundle.py
    LEGAL_BUNDLE_OUT=android/app/src/main/assets/legal python3 tools/legal_bundle.py

build:
    cd android && ./gradlew :app:assembleDebug

# O backend local chega ao aparelho por `adb reverse` (o debug fala com localhost:8080).
reverse:
    adb reverse tcp:8080 tcp:8080

install: reverse
    cd android && ./gradlew :app:installDebug
    adb shell am start -n {{ app }}/.MainActivity

# Build de release no seu celular, o `install-ios-device` do Android: R8, .so de release e
# a chave de upload do `keystore.properties`. Fala com o API_BASE_URL do .env, que hoje é
# a produção (o release recusa URL sem https). A assinatura difere da de debug, então o
# Android recusa instalar por cima dela: desinstale o debug antes (apaga os dados dele).
# Sem argumento, no único aparelho conectado; com argumento, no serial de `adb devices`.
# Uso: just android/install-device        ou   just android/install-device <serial>
install-device device="": (generate "release")
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f android/keystore.properties ]; then
    	echo "Falta android/keystore.properties (modelo em keystore.properties.example)." >&2
    	exit 1
    fi
    device="{{ device }}"
    if [ -z "$device" ]; then
    	devices=$(adb devices | awk 'NR > 1 && $2 == "device" { print $1 }')
    	if [ "$(printf '%s\n' "$devices" | grep -c .)" -ne 1 ]; then
    		echo "Conecte um aparelho só, ou passe o serial de 'adb devices'." >&2
    		exit 1
    	fi
    	device="$devices"
    fi
    (cd android && ./gradlew :app:assembleRelease)
    apk=android/app/build/outputs/apk/release/app-release.apk
    if ! out=$(adb -s "$device" install -r "$apk" 2>&1); then
    	echo "$out" >&2
    	if grep -q INSTALL_FAILED_UPDATE_INCOMPATIBLE <<<"$out"; then
    		echo "O aparelho tem o build de debug, assinado com outra chave. Rode 'adb -s $device uninstall {{ app }}' e tente de novo." >&2
    	fi
    	exit 1
    fi
    adb -s "$device" shell am start -n {{ app }}/.MainActivity

# A trilha e os documentos legais que viajam no app saem da API de produção (API_BASE_URL
# do .env), nunca do banco local, com as mesmas portas do iOS: conteúdo e documentos sem
# pendência nem rascunho, toda língua publicada inteira. O .aab leva o mapeamento do R8 e
# os símbolos do .so, para o Play ler os crashes. O versionCode é o `build` de
# version.properties: o Play recusa um repetido, então suba-o antes de cada envio.
#
# O mesmo mapeamento e o .so sem strip sobem a PostHog, para o Error Tracking (ADR 0024):
# precisa do posthog-cli e de POSTHOG_CLI_HOST, POSTHOG_CLI_PROJECT_ID e
# POSTHOG_CLI_API_KEY no .env. Sem eles, o release para: crash de versão sem símbolo
# fica ilegível para sempre.
#
# Saída: android/build/store/LogN.aab. Envie pelo Play Console (teste interno primeiro).
# Para o seu celular, o caminho é o `install-device`.
#
# Build de loja, o `release-ios` do Android: o .aab para o Play Console, sem enviar.
release: release-preflight (generate "release")
    #!/usr/bin/env bash
    set -euo pipefail
    envval() { sed -n "s/^$1=//p" .env | tr -d "\"'\r" | sed 's/[[:space:]]*$//' | tail -1; }
    # O .so tem de chegar ao Gradle com build ID e linha do Core: sem um dos dois o
    # posthog-cli o pula sem erro, e o release sairia verde sem símbolo nenhum.
    readelf=$(ls {{ ndk }}/toolchains/llvm/prebuilt/*/bin/llvm-readelf | head -1)
    # Saída numa variável antes do grep: o `grep -q` fecha o pipe cedo, o readelf morre de
    # SIGPIPE, e o pipefail tomaria isso por falha.
    for so in android/generated/boltffi/jniLibs/*/libshared_core.so; do
    	notes=$("$readelf" -n "$so")
    	sections=$("$readelf" -S "$so")
    	if ! grep -q "Build ID" <<<"$notes" || ! grep -q "\.debug_line" <<<"$sections"; then
    		echo "$so sem build ID ou sem .debug_line: confira shared_core/boltffi.toml e o [profile.release]." >&2
    		exit 1
    	fi
    done
    base=$(envval API_BASE_URL)
    if [ -z "$base" ]; then echo "API_BASE_URL vazio no .env" >&2; exit 1; fi
    echo "Conteúdo e documentos legais de $base"
    {{ just_executable() }} --justfile Justfile --working-directory . content-check release
    {{ just_executable() }} --justfile Justfile --working-directory . legal-check release
    env -u LEGAL_BUNDLE_ALLOW_DRAFT SEED_BUNDLE_BASE_URL="$base" SEED_BUNDLE_OUT=android/app/src/main/assets/trail-seed.json python3 tools/seed_bundle.py --release
    env -u LEGAL_BUNDLE_ALLOW_DRAFT LEGAL_BUNDLE_BASE_URL="$base" LEGAL_BUNDLE_OUT=android/app/src/main/assets/legal python3 tools/legal_bundle.py
    # A chave vai só a este Gradle, nunca a um export, e nunca ao echo. Sem daemon e sem
    # configuration cache: os dois guardariam o ambiente da chamada, e o cache o grava em
    # disco e o reusaria depois de a chave ser trocada.
    ph_host=$(envval POSTHOG_CLI_HOST)
    ph_project=$(envval POSTHOG_CLI_PROJECT_ID)
    ph_key=$(envval POSTHOG_CLI_API_KEY)
    mkdir -p android/build
    log=android/build/gradle-release.log
    (cd android && env POSTHOG_CLI_HOST="$ph_host" POSTHOG_CLI_PROJECT_ID="$ph_project" POSTHOG_CLI_API_KEY="$ph_key" \
    	./gradlew --no-daemon --no-configuration-cache --console=plain -Plogn.posthogUpload :app:bundleRelease) | tee "$log"
    # Rodou ou já tinha subido o mesmo (UP-TO-DATE). SKIPPED é upload que não aconteceu.
    for task in uploadPostHogProguardMappingsRelease uploadPostHogNativeSymbolsRelease; do
    	if ! grep -qE "^> Task :app:$task( UP-TO-DATE)?\$" "$log"; then
    		echo "$task não rodou (veja $log): os símbolos desta versão não subiram a PostHog." >&2
    		exit 1
    	fi
    done
    rm -rf android/build/store
    mkdir -p android/build/store
    cp android/app/build/outputs/bundle/release/app-release.aab android/build/store/LogN.aab
    name=$(sed -n 's/^name=//p' version.properties)
    code=$(sed -n 's/^build=//p' version.properties)
    echo "Pronto: android/build/store/LogN.aab (versão $name, versionCode $code). Envie pelo Play Console."

# Sobe o .aab do `release` ao teste interno do Play, com as notas de
# android/release-notes.txt nas três línguas. `completed` publica para os testadores;
# `draft` deixa como rascunho no Console. Precisa de estar em `play_publishers` no
# Terraform e da conta logn-play-publisher convidada no Play Console.
# Uso: just android/play-internal        ou        just android/play-internal draft
play-internal status="completed":
    python3 tools/play_upload.py check
    python3 tools/play_upload.py upload {{ status }}

# Leva à produção o build de version.properties que já está no teste interno: o mesmo
# .aab e as mesmas notas, sem subir nada de novo. Chega à loja depois da revisão do Play.
play-production:
    python3 tools/play_upload.py promote

# O que o `release` precisa e não se vê antes de minutos de build do Core: assinatura,
# posthog-cli e as três POSTHOG_CLI_* (ADR 0024). Só confere; os valores não saem daqui.
release-preflight:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f android/keystore.properties ]; then
    	echo "Falta android/keystore.properties: sem ela o .aab sai sem assinatura." >&2
    	exit 1
    fi
    if [ ! -f .env ]; then echo "Falta o .env na raiz." >&2; exit 1; fi
    if ! command -v posthog-cli >/dev/null; then
    	echo "Falta o posthog-cli (brew install posthog/tap/posthog-cli): sem ele os símbolos não sobem." >&2
    	exit 1
    fi
    for key in POSTHOG_CLI_HOST POSTHOG_CLI_PROJECT_ID POSTHOG_CLI_API_KEY; do
    	value=$(sed -n "s/^$key=//p" .env | tr -d "\"'\r" | sed 's/[[:space:]]*$//' | tail -1)
    	if [ -z "$value" ] || [[ "$value" == *SuaChaveAqui* ]]; then
    		echo "$key vazio no .env: sem ele os símbolos não sobem a PostHog." >&2
    		exit 1
    	fi
    done

# Abre como visitante, o `-LogNStartAsGuest` de iOS. Só em debug.
guest: reverse
    adb shell am force-stop {{ app }}
    adb shell am start -n {{ app }}/.MainActivity --ez logn.start_as_guest true

# Captura da tela do aparelho. Uso: just android/shot /caminho/tela.png
shot path:
    adb exec-out screencap -p >| {{ path }}

# Toque em pixels do aparelho (1080×2400 no de teste). Uso: just android/tap 540 1200
tap x y:
    adb shell input tap {{ x }} {{ y }}

test:
    cd android && ./gradlew :core-shell:testDebugUnitTest :app:testDebugUnitTest

# Testes no aparelho conectado: a ponte com o .so de verdade.
itest:
    cd android && ./gradlew :app:connectedDebugAndroidTest

lint:
    ktlint "android/app/src/**/*.kt" "android/core-shell/src/**/*.kt"
    cd android && ./gradlew :app:lintDebug :core-shell:lintDebug

# Medida solta fora de ui/theme: número com .dp/.sp em tela é token que falta.
tokens-gate:
    ! grep -rnE '[0-9]\.?[0-9]*\.(dp|sp)\b' android/app/src/main/java --include=*.kt | grep -v '/ui/theme/'

# Os .so alinhados a 16 KB (exigência do Play para Android 15+).
check-16kb:
    for so in android/generated/boltffi/jniLibs/*/libshared_core.so; do \
        align=$(llvm-objdump -p "$so" 2>/dev/null | awk '/LOAD/{print $NF; exit}' || true); \
        echo "$so $align"; \
    done

# Cheque do dia a dia: gerar, compilar, testar e o portão de tokens.
check: generate build test tokens-gate
