<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- O login com GitHub abre em Custom Tab; sem isto, Android 11+ não enxerga o
         navegador que atende. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- A permissão BILLING vem da Play Billing Library (app/build.gradle.kts). Escrita
         aqui à mão, sem a biblioteca, o Play Console a lê como a API AIDL antiga.

         Sem backup e sem transferência entre aparelhos: a sessão e a chave das trilhas
         pagas moram no Keystore deste aparelho (ADR 0023), e restaurar o resto sem elas
         deixa o app num estado que o Core não espera. -->
    <application
        android:name=".LognApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LogN.Starting">
        <!-- Retrato e escuro, como em iOS. `singleTask`: o retorno do login com GitHub
             e os links de e-mail voltam para a mesma Activity, por onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- logn://verify, logn://reset-password e logn://oauth/github, os mesmos
                 links de iOS. Um filtro por link: os <data> de um mesmo filtro se
                 combinam, e o path do GitHub valeria para os links de e-mail também. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logn" />
                <data android:host="verify" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logn" />
                <data android:host="reset-password" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="logn" />
                <data android:host="oauth" />
                <data android:path="/github" />
            </intent-filter>
        </activity>
    </application>

</manifest>
