<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A splash do sistema: o símbolo sobre o canvas, até o Compose desenhar a do app. -->
    <style name="Theme.LogN.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/logn_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_symbol</item>
        <item name="postSplashScreenTheme">@style/Theme.LogN</item>
    </style>

    <!-- Claro aqui e escuro em values-night, como o sistema (ADR 0030). O fundo da janela é
         o canvas, para não piscar entre a splash e o primeiro quadro. O pai claro também
         diz ao WebView do documento legal que o tema é claro (`prefers-color-scheme`). -->
    <style name="Theme.LogN" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/logn_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
