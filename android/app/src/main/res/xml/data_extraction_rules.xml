<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para o backup na nuvem nem passa para outro aparelho: a sessão e as chaves
     ficam no Keystore deste aparelho, e o resto sem elas não serve (ADR 0023). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
